# Copier en .env (jamais commité) et remplir. Voir deploy/README.md.

# Nom de domaine qui pointe vers le serveur (ex. mon-fym.duckdns.org)
DOMAIN=

# Mot de passe de la base : openssl rand -base64 24
DB_PASSWORD=
# Clé de signature des sessions, 32 caractères minimum : openssl rand -base64 48
JWT_SECRET=

# Emails ayant le rôle ADMIN, séparés par des virgules
ADMIN_EMAILS=

# Emails (vérification d'adresse, mot de passe oublié, alertes).
# false : les liens sont écrits dans les logs (docker compose logs api).
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=FollowYourMoney <no-reply@example.com>

# Push Web : vides = clés générées au premier usage et gardées en base.
# Les changer ensuite invalide tous les abonnements push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
